# Copy to .env for local dev, or set these as environment variables on
# Render for production (see DEPLOY.md).

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders
SHOPIFY_APP_URL=

# Neon connection string (use the "pooled" connection string from the Neon
# dashboard so serverless functions don't exhaust direct connections).
# Use a separate Neon branch/connection string per environment (dev vs prod) —
# see DEPLOY.md, section "Test/Prod DB 분리".
DATABASE_URL=

# Shared secret for the /internal/cleanup retention job (called by
# cron-job.org — see DEPLOY.md). Generate with: openssl rand -hex 32
CLEANUP_SECRET=

# Partner API credentials, used ONLY to check a shop's current Shopify App
# Pricing plan (billing.check()/the Admin API does not see these
# subscriptions — see app/models/billing.server.ts for why). Without these,
# the app silently falls back to billing.check() alone, which will never
# report a paying merchant as "pro".
#   SHOPIFY_PARTNER_ORG_ID: the number in your Partner Dashboard's URL
#     (partners.shopify.com/<this number>/...).
#   SHOPIFY_PARTNER_API_ACCESS_TOKEN: Partner Dashboard → Settings → Partner
#     API clients → create a client with the "Manage apps" permission.
#   SHOPIFY_APP_GID: gid://shopify/App/<app id>, where <app id> is the
#     number in this app's Partner Dashboard URL.
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=
